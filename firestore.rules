rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // doar jucătorii camerei (cheile din `players`) pot citi / scrie mesaje
    function isMember(roomCode) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/games/$(roomCode)).data.players;
    }

    match /games/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.hostId == request.auth.uid;

      // chat + mesaje de sistem ("X a cucerit Sector 3")
      match /messages/{messageId} {
        allow read: if isMember(roomCode);
        allow create: if isMember(roomCode)
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300;
      }
    }
  }
}
